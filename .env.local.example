NEXT_PUBLIC_SUPABASE_URL=https://dboqqtfsywhjqhbpxdbm.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Generate each value with a cryptographically secure random generator.
# Example: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ALTCHA_HMAC_SECRET=replace-with-at-least-32-random-characters
PUBLIC_REGISTRATION_HASH_SECRET=replace-with-at-least-32-random-characters

# Optional bounded public-registration settings.
# ALTCHA_CHALLENGE_TTL_SECONDS=300
# PUBLIC_REGISTRATION_RATE_LIMIT_MAX_ATTEMPTS=5
# PUBLIC_REGISTRATION_RATE_LIMIT_WINDOW_SECONDS=900

# Server-only Prisma connection string (NEVER prefix with NEXT_PUBLIC_)
# Use the Supabase pooler connection string (Transaction mode recommended)
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
