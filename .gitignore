# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# agent metadata
.atl/

# prisma generated client (reproducible via pnpm db:generate)
lib/prisma/generated/

.claude

.agents

.vscode

.kiro
.next

# agent/tooling scratch directories and local lockfiles
.codegraph
.codex
supabase/.temp
skills-lock.json

# dojo-stories source videos (~34MB, inputs of pnpm stories:build;
# published outputs live in public/media/dojo-stories)
/assets/*.mp4

# OpenNext Cloudflare build output
.open-next/

# wrangler local files
.wrangler
.dev.vars*
!.dev.vars.example

# pnpm local store artifact
.pnpm-store/
